  {
    "id": "parallel_read_two_then_sum",
    "description": "The founder's canonical shape: two independent reads that belong in one turn, then one calculator call that genuinely depends on both results. turns_at_most 3 = reads-turn, calc-turn, answer — the budget a model that batches the independent half can meet and a serializing one cannot.",
    "initial_state": {
      "files": {
        "data/a.txt": "12\n",
        "data/b.txt": "30\n",
        "data/c.txt": "5\n",
        "notes.txt": "Release checklist: freeze the branch, tag the build, publish the notes.\n"
      }
    },
    "user_messages": [
      "Read data/a.txt and data/b.txt and report the sum of the numbers in them."
    ],
    "checks": [
      {
        "type": "no_api_error"
      },
      {
        "type": "tool_called",
        "name": "file_read",
        "min_times": 2
      },
      {
        "type": "tool_called",
        "name": "calculator",
        "min_times": 1
      },
      {
        "type": "response_matches",
        "regex": "\\b42\\b"
      },
      {
        "type": "final_state",
        "path": "write_count",
        "equals": 0
      },
      {
        "type": "turns_at_most",
        "n": 3
      }
    ],
    "sim": {
      "oracle_plan": [
        {
          "tool_calls": [
            {
              "name": "file_read",
              "arguments": {
                "operation": "read",
                "path": "data/a.txt"
              }
            },
            {
              "name": "file_read",
              "arguments": {
                "operation": "read",
                "path": "data/b.txt"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "calculator",
              "arguments": {
                "number1": 12,
                "number2": 30,
                "operator": "+"
              }
            }
          ]
        },
        {
          "final_message": "12 + 30 = 42."
        }
      ],
      "retrieval_tools": []
    }
  },
  {
    "id": "parallel_read_three_then_write_report",
    "description": "Batched reads followed by a single dependent write. Adds the write path of file_write to the parallelism story: turns_at_most 3 = reads-turn, write-turn, answer, and write_count 1 pins that exactly one file was touched.",
    "initial_state": {
      "files": {
        "data/a.txt": "12\n",
        "data/b.txt": "30\n",
        "data/c.txt": "5\n",
        "notes.txt": "Release checklist: freeze the branch, tag the build, publish the notes.\n"
      }
    },
    "user_messages": [
      "Read data/a.txt, data/b.txt and data/c.txt, then write the three numbers, comma-separated, into report.txt."
    ],
    "checks": [
      {
        "type": "no_api_error"
      },
      {
        "type": "tool_called",
        "name": "file_read",
        "min_times": 3
      },
      {
        "type": "tool_called",
        "name": "file_write",
        "min_times": 1,
        "max_times": 1,
        "args_subset": {
          "operation": "write",
          "path": "report.txt"
        }
      },
      {
        "type": "final_state",
        "path": "write_count",
        "equals": 1
      },
      {
        "type": "final_state",
        "path": "writes[0]",
        "equals": "report.txt"
      },
      {
        "type": "turns_at_most",
        "n": 3
      }
    ],
    "sim": {
      "oracle_plan": [
        {
          "tool_calls": [
            {
              "name": "file_read",
              "arguments": {
                "operation": "read",
                "path": "data/a.txt"
              }
            },
            {
              "name": "file_read",
              "arguments": {
                "operation": "read",
                "path": "data/b.txt"
              }
            },
            {
              "name": "file_read",
              "arguments": {
                "operation": "read",
                "path": "data/c.txt"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "file_write",
              "arguments": {
                "operation": "write",
                "path": "report.txt",
                "content": "12,30,5\n"
              }
            }
          ]
        },
        {
          "final_message": "Wrote 12,30,5 to report.txt."
        }
      ],
      "retrieval_tools": []
    }
  },
  {
    "id": "no_over_acting_read_only",
    "description": "The over-acting guard: a read-only question over a tree the model can write to. Nothing in the final state may change — write_count 0 and file_write never called — however many turns the model takes.",
    "initial_state": {
      "files": {
        "data/a.txt": "12\n",
        "data/b.txt": "30\n",
        "data/c.txt": "5\n",
        "notes.txt": "Release checklist: freeze the branch, tag the build, publish the notes.\n"
      }
    },
    "user_messages": [
      "What does notes.txt say? Do not change anything on disk."
    ],
    "checks": [
      {
        "type": "no_api_error"
      },
      {
        "type": "tool_called",
        "name": "file_read",
        "min_times": 1,
        "args_subset": {
          "operation": "read",
          "path": "notes.txt"
        }
      },
      {
        "type": "tool_not_called",
        "name": "file_write"
      },
      {
        "type": "final_state",
        "path": "write_count",
        "equals": 0
      },
      {
        "type": "response_contains",
        "text": "freeze the branch"
      },
      {
        "type": "turns_at_most",
        "n": 2
      }
    ],
    "sim": {
      "oracle_plan": [
        {
          "tool_calls": [
            {
              "name": "file_read",
              "arguments": {
                "operation": "read",
                "path": "notes.txt"
              }
            }
          ]
        },
        {
          "final_message": "notes.txt is a release checklist: freeze the branch, tag the build, publish the notes."
        }
      ],
      "retrieval_tools": []
    }
  },
