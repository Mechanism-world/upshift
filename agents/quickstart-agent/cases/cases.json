[
  {
    "id": "smoke_calculator_two_plus_two",
    "description": "Smoke case from upstream's own test suite (agents/test_message_params.py:65, BasicAgent asks 'What is 2+2?'). One tool call, one answer: it exists to prove the loop and the calculator agree, not to test parallelism.",
    "initial_state": {},
    "user_messages": [
      "What is 2+2?"
    ],
    "checks": [
      {
        "type": "no_api_error"
      },
      {
        "type": "tool_called",
        "name": "calculator",
        "min_times": 1,
        "args_subset": {
          "operator": "+"
        }
      },
      {
        "type": "response_matches",
        "regex": "\\b4\\b"
      },
      {
        "type": "turns_at_most",
        "n": 2
      }
    ],
    "sim": {
      "oracle_plan": [
        {
          "tool_calls": [
            {
              "name": "calculator",
              "arguments": {
                "number1": 2,
                "number2": 2,
                "operator": "+"
              }
            }
          ]
        },
        {
          "final_message": "2 + 2 = 4."
        }
      ],
      "retrieval_tools": []
    }
  },
