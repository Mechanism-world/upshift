  {
    "id": "parallel_three_calculations",
    "description": "THE point of this target: three arithmetic questions with no dependency between them. Upstream executes every tool_use block of a turn concurrently (agents/utils/tool_util.py:27-35, asyncio.gather), so the intended shape is one assistant turn issuing three calculator calls. turns_at_most 2 = that turn plus the answer.",
    "initial_state": {},
    "user_messages": [
      "What are 12*7, 9*9 and 15+27? Give me all three numbers."
    ],
    "checks": [
      {
        "type": "no_api_error"
      },
      {
        "type": "tool_called",
        "name": "calculator",
        "min_times": 3
      },
      {
        "type": "response_matches",
        "regex": "\\b84\\b"
      },
      {
        "type": "response_matches",
        "regex": "\\b81\\b"
      },
      {
        "type": "response_matches",
        "regex": "\\b42\\b"
      },
      {
        "type": "turns_at_most",
        "n": 2
      }
    ],
    "sim": {
      "oracle_plan": [
        {
          "tool_calls": [
            {
              "name": "calculator",
              "arguments": {
                "number1": 12,
                "number2": 7,
                "operator": "*"
              }
            },
            {
              "name": "calculator",
              "arguments": {
                "number1": 9,
                "number2": 9,
                "operator": "*"
              }
            },
            {
              "name": "calculator",
              "arguments": {
                "number1": 15,
                "number2": 27,
                "operator": "+"
              }
            }
          ]
        },
        {
          "final_message": "12*7 = 84, 9*9 = 81, and 15+27 = 42."
        }
      ],
      "retrieval_tools": []
    }
  },
  {
    "id": "parallel_read_three_files",
    "description": "Three independent file reads that a batching model issues in one turn. No arithmetic, so the only thing turns_at_most 2 can measure is whether the reads were batched.",
    "initial_state": {
      "files": {
        "data/a.txt": "12\n",
        "data/b.txt": "30\n",
        "data/c.txt": "5\n",
        "notes.txt": "Release checklist: freeze the branch, tag the build, publish the notes.\n"
      }
    },
    "user_messages": [
      "Read data/a.txt, data/b.txt and data/c.txt and tell me the number in each one."
    ],
    "checks": [
      {
        "type": "no_api_error"
      },
      {
        "type": "tool_called",
        "name": "file_read",
        "min_times": 3,
        "args_subset": {
          "operation": "read",
          "path": "data/c.txt"
        }
      },
      {
        "type": "response_matches",
        "regex": "\\b12\\b"
      },
      {
        "type": "response_matches",
        "regex": "\\b30\\b"
      },
      {
        "type": "response_matches",
        "regex": "\\b5\\b"
      },
      {
        "type": "final_state",
        "path": "write_count",
        "equals": 0
      },
      {
        "type": "turns_at_most",
        "n": 2
      }
    ],
    "sim": {
      "oracle_plan": [
        {
          "tool_calls": [
            {
              "name": "file_read",
              "arguments": {
                "operation": "read",
                "path": "data/a.txt"
              }
            },
            {
              "name": "file_read",
              "arguments": {
                "operation": "read",
                "path": "data/b.txt"
              }
            },
            {
              "name": "file_read",
              "arguments": {
                "operation": "read",
                "path": "data/c.txt"
              }
            }
          ]
        },
        {
          "final_message": "data/a.txt has 12, data/b.txt has 30 and data/c.txt has 5."
        }
      ],
      "retrieval_tools": []
    }
