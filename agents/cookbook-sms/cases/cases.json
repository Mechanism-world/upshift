  {
    "id": "order_help_with_username",
    "description": "The notebook's third example input (cell 39: 'I need help looking up an order.  My username is jenny76'), verbatim including its double space. The notebook narrates that Claude calls get_customer_info here; the agent then has to text the result back, since text is its only channel. The oracle plan's outgoing text is the bare field value: the sim substitutes `$ref:` only when it is the whole argument value, so a natural sentence around it would not resolve.",
    "initial_state": {},
    "user_messages": [
      "I need help looking up an order.  My username is jenny76"
    ],
    "checks": [
      {
        "type": "no_api_error"
      },
      {
        "type": "tool_called",
        "name": "get_customer_info",
        "min_times": 1,
        "args_subset": {
          "username": "jenny76"
        }
      },
      {
        "type": "tool_called",
        "name": "send_text_to_user",
        "min_times": 1
      },
      {
        "type": "final_state",
        "path": "lookups[0]",
        "equals": "jenny76"
      },
      {
        "type": "final_state",
        "path": "delivered.purchases",
        "equals": true
      }
    ],
    "sim": {
      "oracle_plan": [
        {
          "tool_calls": [
            {
              "name": "get_customer_info",
              "arguments": {
                "username": "jenny76"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "send_text_to_user",
              "arguments": {
                "text": "$ref:get_customer_info[0].purchases[0].product"
              }
            }
          ]
        },
        {
          "final_message": "Sent."
        }
      ]
    }
  },
