{
  "name": "python-runner-example",
  "model": "stub-model-a",
  "endpoint": "chat_completions",
  "runner": {
    "kind": "command",
    "workdir": "app",
    "command": ["python3", "python_runner.py"],
    "env": {"EXAMPLE_MODEL": "{model}", "EXAMPLE_CASE": "{case_id}", "EXAMPLE_REP": "{rep}"},
    "timeout_s": 60,
    "isolation": "workdir-copy"
  }
}
