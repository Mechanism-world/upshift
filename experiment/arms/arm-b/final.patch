--- /dev/null
+++ b/tests/test_llm_openai_gpt6_astra.py
@@ -0,0 +1,232 @@
+"""GPT-6 Astra migration contracts.
+
+Every assertion here mirrors a constraint the live API enforced on 2026-09-14; the
+400 bodies are quoted next to the table they justify in ``gptme/llm/llm_openai.py``.
+These are additions -- they extend the contracts that ``test_llm_openai.py``,
+``test_llm_openai_sampling.py`` and ``test_llm_openai_reasoning_effort.py`` already
+assert for the GPT-5 family to the model gptme is migrating to. Nothing here
+requires network access.
+"""
+
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from gptme.llm import llm_openai
+from gptme.llm.llm_openai import (
+    _requires_responses_api_for_tools,
+    _resolve_reasoning_effort,
+    _should_use_responses_api,
+    chat,
+    extra_body,
+    openai_efforts_for_model,
+)
+from gptme.llm.models import get_model
+from gptme.message import Message
+from gptme.tools.base import Parameter, ToolSpec
+
+ASTRA = "openai/gpt-6-astra"
+SOL = "openai/gpt-5.6-sol"
+
+
+@pytest.fixture
+def _tool() -> ToolSpec:
+    return ToolSpec(
+        name="ping",
+        desc="Ping something.",
+        parameters=[
+            Parameter(name="target", type="string", description="what", required=True)
+        ],
+    )
+
+
+def _client() -> SimpleNamespace:
+    return SimpleNamespace(base_url="https://api.openai.com/v1")
+
+
+# --- M1: endpoint -----------------------------------------------------------
+
+
+def test_astra_registry_declares_responses_api():
+    """The registry flag is what routes the request; it must be set for the target."""
+    assert get_model(ASTRA).supports_responses_api is True
+
+
+def test_astra_requires_responses_api_for_tools():
+    assert _requires_responses_api_for_tools(get_model(ASTRA)) is True
+    assert _requires_responses_api_for_tools(get_model(SOL)) is False
+
+
+def test_astra_uses_responses_api_by_default(monkeypatch, _tool):
+    monkeypatch.delenv("GPTME_OPENAI_RESPONSES_API", raising=False)
+    monkeypatch.setattr(llm_openai, "_is_proxy", lambda _client: False)
+    assert (
+        _should_use_responses_api("openai", get_model(ASTRA), _client(), [_tool])
+        is True
+    )
+
+
+def test_astra_tool_call_ignores_the_responses_opt_out(monkeypatch, _tool):
+    """`/v1/chat/completions` + function tools is a hard 400 on this model.
+
+    The opt-out is a preference; with tools present there is no working Chat
+    Completions request to fall back to, so it must not send one.
+    """
+    monkeypatch.setenv("GPTME_OPENAI_RESPONSES_API", "0")
+    monkeypatch.setattr(llm_openai, "_is_proxy", lambda _client: False)
+    assert (
+        _should_use_responses_api("openai", get_model(ASTRA), _client(), [_tool])
+        is True
+    )
+    # Without tools, Chat Completions is supported and the opt-out still applies.
+    assert (
+        _should_use_responses_api("openai", get_model(ASTRA), _client(), None) is False
+    )
+    # And the opt-out is untouched for a model that has no such restriction.
+    assert (
+        _should_use_responses_api("openai", get_model(SOL), _client(), [_tool]) is False
+    )
+
+
+# --- M2: sampling parameters ------------------------------------------------
+
+
+def test_astra_request_carries_no_sampling_parameters(monkeypatch, _tool):
+    """`temperature`, `top_p` and `top_logprobs` are removed parameters on Astra."""
+    monkeypatch.delenv("GPTME_THINKING_EFFORT", raising=False)
+    monkeypatch.setattr(llm_openai, "_is_proxy", lambda _client: False)
+
+    response = SimpleNamespace(
+        output=[
+            SimpleNamespace(
+                type="message",
+                content=[SimpleNamespace(type="output_text", text="ok")],
+            )
+        ],
+        usage=None,
+    )
+    create = Mock(return_value=response)
+    monkeypatch.setattr(
+        llm_openai,
+        "get_client",
+        lambda _provider: SimpleNamespace(
+            base_url="https://api.openai.com/v1",
+            responses=SimpleNamespace(create=create),
+        ),
+    )
+
+    chat([Message("user", "hi")], ASTRA, [_tool])
+
+    sent = create.call_args.kwargs
+    for banned in ("temperature", "top_p", "top_logprobs", "logprobs"):
+        assert banned not in sent, f"{banned} must not be sent to gpt-6-astra"
+
+
+def test_astra_extra_body_carries_no_sampling_parameters(monkeypatch):
+    monkeypatch.delenv("GPTME_THINKING_EFFORT", raising=False)
+    body = extra_body("openai", get_model(ASTRA))
+    for banned in ("temperature", "top_p", "top_logprobs", "logprobs"):
+        assert banned not in body
+
+
+# --- M3: reasoning-effort validity ------------------------------------------
+
+
+def test_astra_accepted_efforts_match_the_api():
+    """Read back from the API's own 400 bodies; note the endpoint difference."""
+    astra = get_model(ASTRA)
+    assert openai_efforts_for_model(astra, "responses") == frozenset(
+        {"low", "medium", "high", "xhigh", "max"}
+    )
+    assert openai_efforts_for_model(astra, "chat_completions") == frozenset(
+        {"low", "medium", "high", "xhigh"}
+    )
+
+
+def test_unlisted_model_keeps_the_sdk_wide_effort_set():
+    """A model with no entry must behave exactly as before this table existed."""
+    assert openai_efforts_for_model(get_model(SOL)) == frozenset(
+        llm_openai._OPENAI_REASONING_EFFORTS
+    )
+
+
+@pytest.mark.parametrize("level", ["none", "minimal"])
+def test_astra_rejects_none_and_minimal_with_an_actionable_error(monkeypatch, level):
+    """Both are accepted by the SDK literal and by gpt-5.x, and 400 on Astra.
+
+    The failure must arrive as a local, actionable error naming the supported
+    levels -- not as an HTTP 400 in the middle of a conversation.
+    """
+    monkeypatch.setenv("GPTME_THINKING_EFFORT", level)
+    with pytest.raises(ValueError, match="gpt-6-astra") as excinfo:
+        _resolve_reasoning_effort("openai", get_model(ASTRA), "responses")
+    message = str(excinfo.value)
+    assert "gpt-6-astra" in message
+    assert "low" in message
+    # The migration guide's replacement for both levels.
+    assert "Use 'low' instead." in message
+
+
+def test_astra_rejects_max_on_chat_completions_only(monkeypatch):
+    """`max` is valid on /v1/responses and rejected on /v1/chat/completions."""
+    monkeypatch.setenv("GPTME_THINKING_EFFORT", "max")
+    assert _resolve_reasoning_effort("openai", get_model(ASTRA), "responses") == "max"
+    with pytest.raises(ValueError, match="chat/completions"):
+        _resolve_reasoning_effort("openai", get_model(ASTRA), "chat_completions")
+
+
+@pytest.mark.parametrize("level", ["low", "medium", "high", "xhigh"])
+def test_astra_accepts_the_common_levels_on_both_endpoints(monkeypatch, level):
+    monkeypatch.setenv("GPTME_THINKING_EFFORT", level)
+    astra = get_model(ASTRA)
+    assert _resolve_reasoning_effort("openai", astra, "responses") == level
+    assert _resolve_reasoning_effort("openai", astra, "chat_completions") == level
+    assert extra_body("openai", astra)["reasoning_effort"] == level
+
+
+@pytest.mark.parametrize("level", ["none", "minimal", "max"])
+def test_other_openai_models_are_unaffected(monkeypatch, level):
+    """The narrowing is per-model; gpt-5.6-sol must keep every SDK level."""
+    monkeypatch.setenv("GPTME_THINKING_EFFORT", level)
+    assert _resolve_reasoning_effort("openai", get_model(SOL), "responses") == level
+    assert (
+        _resolve_reasoning_effort("openai", get_model(SOL), "chat_completions") == level
+    )
+
+
+# --- behaviour parity with the GPT-5 family ---------------------------------
+
+
+def test_verbosity_applies_to_astra(monkeypatch):
+    """`verbosity` is accepted by gpt-6-astra; the `gpt-5` prefix test dropped it."""
+    monkeypatch.setattr(llm_openai, "OPENAI_VERBOSITY", "low")
+    body: dict = {}
+    llm_openai._maybe_apply_verbosity(body, get_model(ASTRA))
+    assert body["verbosity"] == "low"
+
+
+def test_verbosity_still_skipped_for_non_reasoning_models(monkeypatch):
+    monkeypatch.setattr(llm_openai, "OPENAI_VERBOSITY", "low")
+    body: dict = {}
+    llm_openai._maybe_apply_verbosity(body, get_model("openai/gpt-4o"))
+    assert "verbosity" not in body
+
+
+def test_astra_uses_the_same_message_prep_as_gpt5(monkeypatch):
+    """A migration must not silently change how the conversation is formatted.
+
+    On Chat Completions, `gpt-5*` takes `_prep_o1` (every system message becomes a
+    `<system>` user message, no merging) while other reasoners take
+    `_prep_deepseek_reasoner` (first message kept, rest merged). Selecting Astra
+    must not flip that branch.
+    """
+    messages = [
+        Message("system", "you are gptme"),
+        Message("user", "hi"),
+        Message("system", "a mid-conversation system note"),
+        Message("user", "continue"),
+    ]
+    astra_msgs, _ = llm_openai._prepare_messages_for_api(list(messages), ASTRA, None)
+    sol_msgs, _ = llm_openai._prepare_messages_for_api(list(messages), SOL, None)
+    assert astra_msgs == sol_msgs
