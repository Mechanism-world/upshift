+def _base_model_name(model_meta: ModelMeta) -> str:
+    """Bare model id: no ``provider/`` prefix, no ``@host`` pin, no ``:effort`` suffix.
+
+    Model-specific capability tables are keyed on this, so a model reached as
+    ``openai/gpt-6-astra:high`` is recognised as ``gpt-6-astra``.
+    """
+    name = model_meta.model
+    name = name.split("/")[-1]
+    name = name.split("@")[0]
+    return name.split(":")[0]
+
+
+def _is_gpt5_plus(model_meta: ModelMeta) -> bool:
+    """True for the GPT-5 and GPT-6 families.
+
+    Upstream gated the ``verbosity`` parameter and the o1-style message
+    preparation on ``startswith("gpt-5")``. GPT-6 inherits both behaviours
+    (``verbosity`` verified accepted by ``gpt-6-astra`` on both endpoints,
+    2026-09-14), so the bare prefix test would silently drop them on GPT-6.
+    """
+    return _base_model_name(model_meta).startswith(("gpt-5", "gpt-6"))
+
+
