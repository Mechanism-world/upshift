+
+
+def _requires_responses_api_for_tools(model_meta: ModelMeta) -> bool:
+    """True when sending tools to this model on Chat Completions is a hard 400."""
+    return _base_model_name(model_meta) in _MODELS_REQUIRING_RESPONSES_FOR_TOOLS
+
