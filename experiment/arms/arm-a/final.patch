+# Per-model exceptions to "the subset is enforced server-side".
+#
+# GPT-6 Astra dropped the two cheapest levels: ``reasoning_effort: 'none'``
+# returns HTTP 400, and ``minimal`` is no longer among its accepted values
+# (``low``, ``medium``, ``high``, ``xhigh``, ``max``).  Deferring to the server
+# is not good enough here, because Astra's own 400 for sending tools to
+# /v1/chat/completions *recommends* ``reasoning_effort: 'none'`` as the
+# escape hatch — following the error text produces a second 400.  OpenAI's
+# migration guidance for models that removed these levels is to start at
+# ``low``, which is what we substitute (once, with a warning) so a session that
+# was configured for an older model keeps running after the upgrade instead of
+# failing every request.
+# Source: https://developers.openai.com/api/docs/guides/reasoning
+#         https://developers.openai.com/api/docs/guides/latest-model
+_OPENAI_MODEL_UNSUPPORTED_EFFORTS: dict[str, frozenset[str]] = {
+    "gpt-6-astra": frozenset({"none", "minimal"}),
+}
+_OPENAI_EFFORT_DOWNGRADE_TARGET = "low"
+_effort_downgrade_warned: set[tuple[str, str]] = set()
+
+
+def openai_unsupported_efforts(model_name: str) -> frozenset[str]:
+    """Reasoning levels this OpenAI model rejects despite being valid SDK values."""
+    bare = _DATE_SUFFIX_RE.sub("", _bare_model_name(model_name))
+    return _OPENAI_MODEL_UNSUPPORTED_EFFORTS.get(bare, frozenset())
+
+
+def valid_reasoning_efforts(provider: Provider, model_meta: ModelMeta) -> set[str]:
+    """The reasoning levels this (provider, model) pair actually accepts.
+
+    This is what the application should report as valid — not the raw SDK
+    literal, which includes levels individual models reject with a 400.
+    """
+    if provider == "moonshot" and model_meta.model == "kimi-k3":
+        return set(_KIMI_K3_REASONING_EFFORTS)
+    if not model_meta.supports_reasoning:
+        return set()
+    if provider == "openai":
+        return _OPENAI_REASONING_EFFORTS - openai_unsupported_efforts(model_meta.model)
+    if provider == "openrouter":
+        return set(_OPENROUTER_REASONING_EFFORTS)
+    return set()
+
 
