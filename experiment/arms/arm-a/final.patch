+# gpt-5 and later (gpt-5..gpt-9, gpt-10+).  These share a set of wire quirks
+# (restricted sampling parameters, ``max_completion_tokens`` instead of
+# ``max_tokens``, the ``verbosity`` field, o1-style message preparation).
+# Matched by family so new releases in these lines keep working without a code
+# change; older models (gpt-4o, gpt-4.1, ...) are excluded.
+#
+# Several call sites previously spelled this check as ``"gpt-5" in model`` or
+# ``model.startswith("gpt-5")``, which silently stopped matching at GPT-6 and
+# gave gpt-6-astra a different code path than gpt-5.6-sol on the same request.
+_OPENAI_REASONING_ERA_RE = re.compile(r"^(?:o\d|gpt-(?:[5-9]|\d\d))")
