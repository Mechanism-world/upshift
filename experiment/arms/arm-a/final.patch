@@ -0,0 +1,292 @@
+"""GPT-6 Astra migration contracts.
+
+Extends the existing OpenAI provider contracts (``test_llm_openai.py``,
+``test_llm_openai_sampling.py``, ``test_llm_openai_reasoning_effort.py``) to the
+GPT-6 family.  Every assertion here mirrors one that already exists for
+gpt-5.x; the migration bug class is that the gpt-5 assertions passed while the
+same code silently took a different branch for ``gpt-6-astra``.
+
+Documented behaviour under test (developers.openai.com):
+  - function calling requires ``/v1/responses`` on this model
+  - ``reasoning_effort: 'none'`` returns HTTP 400 (and ``minimal`` is not an
+    accepted level); migration guidance is to start at ``low``
+  - ``temperature`` / ``top_p`` / ``top_logprobs`` are removed
+"""
+
+from types import SimpleNamespace
+from typing import Any, cast
+from unittest.mock import Mock
+
+import pytest
+
+from gptme.llm import llm_openai
+from gptme.llm.llm_openai import (
+    _get_temperature,
+    _get_top_p,
+    _is_gpt5_or_later,
+    _max_tokens_param_name,
+    _resolve_reasoning_effort,
+    _should_use_responses_api,
+    extra_body,
+    valid_reasoning_efforts,
+)
+from gptme.llm.models import get_model
+from gptme.message import Message
+from gptme.tools import ToolSpec
+from gptme.tools.base import Parameter
+
+ASTRA = "openai/gpt-6-astra"
+
+
+@pytest.fixture
+def _tool() -> list[ToolSpec]:
+    return [
+        ToolSpec(
+            name="shell",
+            desc="Run a shell command",
+            parameters=[
+                Parameter(
+                    name="command", type="string", description="cmd", required=True
+                )
+            ],
+        )
+    ]
+
+
+# --- registry ---------------------------------------------------------------
+
+
+def test_astra_is_registered_with_responses_support():
+    """M1 precondition: the endpoint decision is driven by this registry flag."""
+    meta = get_model(ASTRA)
+    assert meta.provider == "openai"
+    assert meta.supports_responses_api is True
+    assert meta.supports_reasoning is True
+    assert meta.supports_strict_tools is True
+
+
+def test_astra_matches_the_gpt5_plus_family():
+    """The wire-quirk branches keyed on the GPT-5+ family must include GPT-6."""
+    assert _is_gpt5_or_later("gpt-6-astra")
+    assert _is_gpt5_or_later("gpt-5.6-sol")
+    assert not _is_gpt5_or_later("gpt-4o")
+    assert _max_tokens_param_name("openai", "gpt-6-astra") == "max_completion_tokens"
+
+
+# --- M1: endpoint -----------------------------------------------------------
+
+
+def test_astra_uses_responses_api_by_default(monkeypatch):
+    monkeypatch.setattr(llm_openai, "_is_proxy", lambda client: False)
+    monkeypatch.delenv("GPTME_OPENAI_RESPONSES_API", raising=False)
+    client = cast(Any, SimpleNamespace())
+    assert _should_use_responses_api("openai", get_model(ASTRA), client) is True
+
+
+def test_astra_keeps_responses_api_for_tool_calls_even_when_disabled(
+    monkeypatch, _tool
+):
+    """The debug opt-out may not route a tool call to chat completions.
+
+    Chat Completions does not support function calling on this model, and the
+    400 it returns advertises ``reasoning_effort: 'none'`` — a value this same
+    model also rejects — so there is no fallback to degrade to.
+    """
+    monkeypatch.setattr(llm_openai, "_is_proxy", lambda client: False)
+    monkeypatch.setenv("GPTME_OPENAI_RESPONSES_API", "0")
+    client = cast(Any, SimpleNamespace())
+    meta = get_model(ASTRA)
+
+    assert _should_use_responses_api("openai", meta, client, _tool) is True
+    # ...but a request with no tools is a legal chat-completions request, so
+    # the debug override still works there.
+    assert _should_use_responses_api("openai", meta, client, None) is False
+    # and the override is still honoured in full for gpt-5.x.
+    assert (
+        _should_use_responses_api(
+            "openai", get_model("openai/gpt-5.6-sol"), client, _tool
+        )
+        is False
+    )
+
+
+def test_astra_chat_with_tools_hits_the_responses_endpoint(monkeypatch, _tool):
+    """End to end: tools present → client.responses.create, not chat.completions."""
+    monkeypatch.delenv("GPTME_THINKING_EFFORT", raising=False)
+    response = SimpleNamespace(
+        usage=None,
+        output=[
+            SimpleNamespace(
+                type="message", content=[SimpleNamespace(type="output_text", text="ok")]
+            )
+        ],
+    )
+    responses_create = Mock(return_value=response)
